# Cle API fal.ai (OBLIGATOIRE pour generer). Une seule cle pour tout le pipeline.
# Ne la commitez jamais. Sans elle, l'API repond 503 sur les routes de generation.
FAL_KEY=

# Plafond de depenses mensuel en USD (defaut : 50).
# Un nouveau job est refuse (HTTP 429) si son estimation depasse le reste du plafond.
MASCOTFORGE_MONTHLY_CAP_USD=50

# Model IDs fal.ai (verifies le 2026-10-19, surchargeables ici).
MASCOTFORGE_TTI_MODEL=fal-ai/flux/dev
MASCOTFORGE_I2V_MODEL=fal-ai/kling-video/v3/standard/image-to-video
MASCOTFORGE_FALLBACK_MODEL=fal-ai/kling-video/v3/pro/image-to-video

# Chemin de ffmpeg si absent du PATH (ffprobe doit etre dans le meme dossier).
# Sans ffmpeg, les mascottes gardent leur fond vert.
# MASCOTFORGE_FFMPEG=C:/ffmpeg/bin/ffmpeg.exe

# Transport fal.ai : auto (defaut), sdk (fal-client) ou rest (HTTP manuel).
# MASCOTFORGE_FAL_TRANSPORT=auto

# Repertoires runtime (defauts : ./data et ./exports a la racine du projet).
# MASCOTFORGE_DATA_DIR=./data
# MASCOTFORGE_EXPORTS_DIR=./exports

# Si "1", POST /api/generate attend la fin du job (pratique pour les tests).
# MASCOTFORGE_SYNC_JOBS=0
